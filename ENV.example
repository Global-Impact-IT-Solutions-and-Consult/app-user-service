# Server Configuration
PORT=3000
API_PREFIX=api
NODE_ENV=development

# PostgreSQL Configuration
# For local development with Docker PostgreSQL:
#   1. Run: docker-compose -f docker-compose.local.yml up -d
#   2. Use these settings:
DB_HOST=localhost
DB_PORT=5433  # Docker PostgreSQL exposed on 5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=user-service

# For local development with local PostgreSQL (if installed):
#   DB_HOST=localhost
#   DB_PORT=5432  # Default PostgreSQL port
#   DB_USERNAME=postgres
#   DB_PASSWORD=your-local-postgres-password
#   DB_DATABASE=user-service

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Encryption Key (for API keys, webhook secrets, and ERP OAuth tokens)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Email Configuration (Resend)
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Zoho Books Configuration
# Create a Server-based / Web app at https://api-console.zoho.com/
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=http://localhost:3000/api/zoho-books/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# Public base URL used when generating per-business webhook links
PUBLIC_API_BASE_URL=http://localhost:3000/api
# Set true to require X-Zoho-Webhook-Token / HMAC on inbound webhooks
# ZOHO_WEBHOOK_REQUIRE_SECRET=false
# Optional: pin a specific Books org; otherwise first org is used
# ZOHO_ORGANIZATION_ID=
# Optional: where to send the browser after OAuth succeeds
# ZOHO_SUCCESS_REDIRECT_URL=http://localhost:4200
# Optional comma-separated scopes override
# ZOHO_SCOPES=ZohoBooks.contacts.ALL,ZohoBooks.invoices.ALL,ZohoBooks.settings.READ
# OAuth poller (every 10 min). Set false to disable cron; manual POST .../sync still works
# ZOHO_POLLING_ENABLED=true
# ZOHO_DEFAULT_ENVIRONMENT=test

# QuickBooks Online (OAuth + poll)
# Create an app at https://developer.intuit.com/
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# QUICKBOOKS_USE_SANDBOX=true
# QUICKBOOKS_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com
# QUICKBOOKS_AUTH_URL=https://appcenter.intuit.com/connect/oauth2
# QUICKBOOKS_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
# QUICKBOOKS_SCOPES=com.intuit.quickbooks.accounting
# QUICKBOOKS_SUCCESS_REDIRECT_URL=http://localhost:4200
# QUICKBOOKS_POLLING_ENABLED=true
# QUICKBOOKS_DEFAULT_ENVIRONMENT=test

# Xero (OAuth + poll)
# Create an app at https://developer.xero.com/
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback
# XERO_AUTH_URL=https://login.xero.com/identity/connect/authorize
# XERO_TOKEN_URL=https://identity.xero.com/connect/token
# XERO_CONNECTIONS_URL=https://api.xero.com/connections
# XERO_API_BASE_URL=https://api.xero.com
# XERO_SCOPES=openid profile email offline_access accounting.invoices accounting.contacts.read
# Optional: pin a specific org; otherwise first connected tenant is used
# XERO_TENANT_ID=
# XERO_SUCCESS_REDIRECT_URL=http://localhost:4200
# XERO_POLLING_ENABLED=true
# XERO_DEFAULT_ENVIRONMENT=test

# Receipt Service Configuration
RECEIPT_SERVICE_URL=http://localhost:3001
# Path used when submitting Zoho invoices for processing (POST multipart/JSON)
RECEIPT_SERVICE_UPLOAD_PATH=/receipts

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
